# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL="file:./showroom.db"

# 3000 for local dev (frontend/vite.config.ts's dev proxy targets it).
# deploy/install-service.ps1 overwrites this to 5000 when installing the
# Windows service — see deploy/README.md.
PORT=3000
NODE_ENV="development"

# Generate a real one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="12h"

APP_NAME="Showroom"

BACKUP_DIR="./backups"

# Comma-separated. Only matters in development — production serves the
# built frontend from this same process, so there is no cross-origin call.
CORS_ORIGINS="http://localhost:5190"

# Used only by prisma/seed.ts to create the one admin account.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123"
